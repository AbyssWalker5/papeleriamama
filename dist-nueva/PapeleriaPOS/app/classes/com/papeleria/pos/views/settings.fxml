<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.papeleria.pos.ui.controller.SettingsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Configuración del Sistema" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="150" prefWidth="150" halignment="RIGHT"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre de Tienda:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="storeNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="addressField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Mensaje de Agradecimiento:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="thankYouMessageField" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Ancho de Ticket (mm):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="ticketWidthField" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Guardar Configuración" onAction="#handleSave" style="-fx-base: #4CAF50;"/>
    </HBox>

    <Separator/>

    <Label text="Respaldo de Datos" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Crear Respaldo" onAction="#handleCreateBackup"/>
        <Button text="Restaurar Respaldo" onAction="#handleRestoreBackup" style="-fx-base: #f44336;"/>
    </HBox>
</VBox>
